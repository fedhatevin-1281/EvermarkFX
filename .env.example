# EvermarkFX Environment Variables
PORT=8080

# Supabase Configuration
# Publishable key = SUPABASE_ANON_KEY
# Secret key      = SUPABASE_SECRET_KEY (service_role key — server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# MakamescoPay (Nexus Pay) Configuration
MAKAMESCO_API_KEY=sk_live_your_makamescopay_key
MAKAMESCO_BASE_URL=https://makamescopay.com
# Optional: custom B2C disbursement endpoint from your MakamescoPay dashboard
MAKAMESCO_B2C_URL=https://makamescopay.com/api/payments/b2c
MAKAMESCO_WEBHOOK_URL=https://evermarkfx.com/api/makamesco-webhook
